{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/app/src/**"
            ],
            "defines": [
                "APPNAME=\"slim\"",
                "VERSION=\"1.3.6\"",
                "SYSCONFDIR=\"/etc\"",
                "PKGDATADIR=\"/usr/share/slim\"",
                "USE_PAM"
            ],
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu17",
            "cppStandard": "gnu++17",
            "compileCommands": [
                "${workspaceFolder}/compile_commands.json"
            ]
        }
    ],
    "version": 4
}